# Copy this file to .env and fill in values locally. Do not commit .env.
DASHSCOPE_API_KEY=
# Optional when using the existing dashscope.aliyuncs.com endpoints.
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# standard: general API; token-plan: interactive Agent media testing only.
DASHSCOPE_SERVICE=standard
ASR_MODEL=qwen3-asr-flash
LLM_MODEL=qwen-flash
TTS_MODEL=cosyvoice-v3.5-flash
# Token Plan media testing uses qwen-audio-3.0-tts-plus with service=token-plan.
# Filled after the character voice sample is received and auditioned.
TTS_VOICE_ID=
MONTHLY_BUDGET_CNY=30
